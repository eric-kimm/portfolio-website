---
import '../styles/globals.css';
import Navbar from '../components/Navbar.astro';
import MainHead from './MainHead.astro'
import { Icon } from 'astro-icon/components'

const {title, seoTitle, seoDesc} = Astro.props
---

<html>
	<MainHead title={title} seoTitle={seoTitle} seoDesc={seoDesc} />
	<body class="bg-white text-black">
		<!-- <Navbar /> -->
		<div class="relative mx-auto w-full max-w-5xl px-6 pb-24 pt-16 sm:px-8 lg:px-16 lg:pt-24">
			<h1 class="text-4xl font-bold tracking-tighter sm:text-5xl">
  				<span id="typed"></span>
			</h1>
			<div id="typed-strings" style="display:none;">
				<p>Eric Kim</p>
			</div>
			<div class="flex items-center gap-5 mt-4">
				<p class="text-black text-sm"> 
					San Jose, CA
				</p>
			</div>

			<div class="mt-10 flex flex-col gap-8 lg:mt-12 lg:flex-row lg:items-start lg:justify-between lg:gap-12">
				<div class="max-w-2xl">
					<p class="text-base leading-relaxed sm:text-lg">
						Hi there! I'm a student at Santa Clara Univeristy studying 
						computer science. My particular interests in software lie in
						backend and applied ML. In my spare time, I enjoy hiking, 
						watching movies, and training jiu jitsu.
					</p>

					<div class="mt-5 flex flex-wrap items-center gap-3 sm:gap-4">
						<a
							href="https://github.com/eric-kimm"
							target="_blank"
							rel="noopener noreferrer"
							class="flex items-center gap-2 rounded-xl border border-black p-2 text-sm sm:text-base hover:underline"
						>
							<Icon name="mdi:github" class="w-5 h-5" /> 
							github
						</a>
						<a 
							href="https://www.linkedin.com/in/kim-ericc/"
							target="_blank"
							rel="noopener noreferrer"
							class="flex items-center gap-2 rounded-xl border border-black p-2 text-sm sm:text-base hover:underline"
						>
							<Icon name="mdi:linkedin" class="w-5 h-5" /> 
							linkedin
						</a>
						<a 
							href="mailto:erickim2208@gmail.com" 
							class="flex items-center gap-2 rounded-xl border border-black p-2 text-sm sm:text-base hover:underline"
						>
							<Icon name="mdi:email-outline" class="w-5 h-5" /> 
							contact
						</a>
					</div>
				</div>

				<img 
					src="/portrait1.jpeg"
					alt="Portrait of Eric Kim"
					class="mx-auto mt-2 h-40 w-40 max-w-full rounded-full border-2 border-white/20 object-cover shadow-xl sm:h-48 sm:w-48 md:h-56 md:w-56 lg:mx-0 lg:mt-0 lg:h-64 lg:w-64"
				/>
			</div>
			

			<h2 class="mt-20 text-xl font-bold mb-4 flex items-center gap-2">
				Education
			</h2>
			<div class="max-w-2xl rounded-2xl border border-black/20 bg-gradient-to-br from-white to-black/[0.02] p-5 shadow-sm sm:p-6">
				<div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
					<div class="space-y-3">
						<span class="inline-flex rounded-full border border-black/20 bg-white px-3 py-1 text-xs font-medium tracking-wide text-black/70">2023 - 2027</span>
						<div>
							<h3 class="text-lg font-semibold text-black">Santa Clara University</h3>
							<p class="text-sm text-black/60">College of Arts and Sciences</p>
						</div>
						<p class="text-black/75">Bachelor of Science in Computer Science</p>
					</div>
					<div class="shrink-0">
						<img
							src="/scu.jpg"
							alt="Santa Clara University"
							class="h-24 w-24 rounded-xl object-cover border border-black/20 shadow-sm sm:h-28 sm:w-28"
						/>
					</div>
				</div>
			</div>

			<h2 class="mt-20 text-xl font-bold mb-4 flex items-center gap-2">
				Experience
			</h2>
			<div class="max-w-2xl rounded-2xl border border-black/20 bg-gradient-to-br from-white to-black/[0.02] p-5 shadow-sm sm:p-6">
				<ol class="relative ml-2 space-y-6 border-l-2 border-black/20">
					<li class="relative pl-8">
						<span class="absolute -left-[9px] top-4 h-4 w-4 rounded-full border-2 border-black bg-white"></span>
						<div class="rounded-xl border border-black/15 bg-white/80 p-4">
							<span class="inline-flex rounded-full border border-black/20 bg-white px-3 py-1 text-xs font-medium tracking-wide text-black/70">June 2023 - August 2023</span>
							<h3 class="mt-3 text-base font-semibold text-black">Data Engineer Intern @ Scaled Entelechy</h3>
							<p class="mt-2 text-black/70">Data extraction pipelines in Python and NLP models.</p>
						</div>
					</li>
					<li class="relative pl-8">
						<span class="absolute -left-[9px] top-4 h-4 w-4 rounded-full border-2 border-black bg-white"></span>
						<div class="rounded-xl border border-black/15 bg-white/80 p-4">
							<span class="inline-flex rounded-full border border-black/20 bg-white px-3 py-1 text-xs font-medium tracking-wide text-black/70">March 2025 - September 2025</span>
							<h3 class="mt-3 text-base font-semibold text-black">Software Engineer @ FreshFrosh</h3>
							<p class="mt-2 text-black/70">Full stack and AI features for user communication with Node.js, Firebase, and React.</p>
						</div>
					</li>
					<li class="relative pl-8">
						<span class="absolute -left-[9px] top-4 h-4 w-4 rounded-full border-2 border-black bg-white"></span>
						<div class="rounded-xl border border-black/15 bg-white/80 p-4">
							<span class="inline-flex rounded-full border border-black/20 bg-white px-3 py-1 text-xs font-medium tracking-wide text-black/70">Jan 2026 - Present</span>
							<h3 class="mt-3 text-base font-semibold text-black">Data Science Researcher @ SCU</h3>
							<p class="mt-2 text-black/70">Working with SCU Men's D1 Basketball to build fatigue and risk of injury models.</p>
						</div>
					</li>
				</ol>
			</div>

			<h2 class="mt-20 text-xl font-bold mb-4 flex items-center gap-2">
				Projects
			</h2>
			<div class="mb-32 max-w-2xl rounded-2xl border border-black/20 bg-gradient-to-br from-white to-black/[0.02] p-5 shadow-sm sm:p-6">
				<div class="space-y-5">
					<a
						href="https://github.com/eric-kimm/ai-screen-reader"
						target="_blank"
						rel="noopener noreferrer"
						class="group block rounded-xl border border-black/15 bg-white/80 p-4 shadow-sm transition duration-200 hover:-translate-y-1 hover:border-black/40 hover:bg-white hover:shadow-xl focus:outline-none focus-visible:-translate-y-1 focus-visible:border-black focus-visible:ring-2 focus-visible:ring-black/20 sm:p-5"
					>
						<div class="flex items-start gap-4">
							<h3 class="font-semibold text-black"> VoiceNav (AI Screen Reader) </h3>
						</div>
						<p class="text-black/70 mt-3">
							Voice controlled Chrome extension to read and navigate web pages for visually impaired users.
						</p>
						<ul class="mt-5 grid grid-cols-1 gap-x-8 gap-y-3 sm:grid-cols-2">
							<li class="flex items-center gap-2 text-black/80">
								<span class="w-1.5 h-1.5 bg-pink-400 rounded-full"></span>
								Python
							</li>
							<li class="flex items-center gap-2 text-black/80">
								<span class="w-1.5 h-1.5 bg-pink-400 rounded-full"></span>
								FastAPI
							</li>
							<li class="flex items-center gap-2 text-black/80">
								<span class="w-1.5 h-1.5 bg-pink-400 rounded-full"></span>
								vLLM
							</li>
							<li class="flex items-center gap-2 text-black/80">
								<span class="w-1.5 h-1.5 bg-pink-400 rounded-full"></span>
								ElevenLabs
							</li>
							<li class="flex items-center gap-2 text-black/80">
								<span class="w-1.5 h-1.5 bg-pink-400 rounded-full"></span>
								AMD Dev Cloud
							</li>
							<li class="flex items-center gap-2 text-black/80">
								<span class="w-1.5 h-1.5 bg-pink-400 rounded-full"></span>
								JavaScript
							</li>
						</ul>
					</a>
					<a
						href="https://github.com/eric-kimm/stock-market-pipeline"
						target="_blank"
						rel="noopener noreferrer"
						class="group block rounded-xl border border-black/15 bg-white/80 p-4 shadow-sm transition duration-200 hover:-translate-y-1 hover:border-black/40 hover:bg-white hover:shadow-xl focus:outline-none focus-visible:-translate-y-1 focus-visible:border-black focus-visible:ring-2 focus-visible:ring-black/20 sm:p-5"
					>
						<div class="flex items-start gap-4">
							<h3 class="font-semibold text-black">Stock Market Pipeline </h3>
						</div>
						<p class="text-black/70 mt-3">
							Distributed systems pipeline on the cloud to alert and analyze stock market trends.
						</p>
						<ul class="mt-5 grid grid-cols-1 gap-x-8 gap-y-3 sm:grid-cols-2">
							<li class="flex items-center gap-2 text-black/80">
								<span class="w-1.5 h-1.5 bg-pink-400 rounded-full"></span>
								Java
							</li>
							<li class="flex items-center gap-2 text-black/80">
								<span class="w-1.5 h-1.5 bg-pink-400 rounded-full"></span>
								Spring Boot
							</li>
							<li class="flex items-center gap-2 text-black/80">
								<span class="w-1.5 h-1.5 bg-pink-400 rounded-full"></span>
								Docker
							</li>
							<li class="flex items-center gap-2 text-black/80">
								<span class="w-1.5 h-1.5 bg-pink-400 rounded-full"></span>
								Apache Kafka
							</li>
							<li class="flex items-center gap-2 text-black/80">
								<span class="w-1.5 h-1.5 bg-pink-400 rounded-full"></span>
								Postgresql
							</li>
							<li class="flex items-center gap-2 text-black/80">
								<span class="w-1.5 h-1.5 bg-pink-400 rounded-full"></span>
								AWS
							</li>
							<li class="flex items-center gap-2 text-black/80">
								<span class="w-1.5 h-1.5 bg-pink-400 rounded-full"></span>
								Redis
							</li>
						</ul>
					</a>

					<a
						href="https://github.com/austinkimchi/CheaterBuster"
						target="_blank"
						rel="noopener noreferrer"
						class="group block rounded-xl border border-black/15 bg-white/80 p-4 shadow-sm transition duration-200 hover:-translate-y-1 hover:border-black/40 hover:bg-white hover:shadow-xl focus:outline-none focus-visible:-translate-y-1 focus-visible:border-black focus-visible:ring-2 focus-visible:ring-black/20 sm:p-5"
					>
						<div class="flex items-start gap-4">
							<h3 class="font-semibold text-black"> AI Proctor </h3>
						</div>
						<p class="text-black/70 mt-3"> Classroom monitoring tool with specialized object detection. </p>
						<ul class="mt-5 grid grid-cols-1 gap-x-8 gap-y-3 sm:grid-cols-2">
							<li class="flex items-center gap-2 text-black/80">
								<span class="w-1.5 h-1.5 bg-pink-400 rounded-full"></span>
								Python
							</li>
							<li class="flex items-center gap-2 text-black/80">
								<span class="w-1.5 h-1.5 bg-pink-400 rounded-full"></span>
								FastAPI
							</li>
							<li class="flex items-center gap-2 text-black/80">
								<span class="w-1.5 h-1.5 bg-pink-400 rounded-full"></span>
								AWS
							</li>
							<li class="flex items-center gap-2 text-black/80">
								<span class="w-1.5 h-1.5 bg-pink-400 rounded-full"></span>
								OpenCV
							</li>
						</ul>
					</a>

					<a
						href="https://github.com/eric-kimm/UFC-Predictor"
						target="_blank"
						rel="noopener noreferrer"
						class="group block rounded-xl border border-black/15 bg-white/80 p-4 shadow-sm transition duration-200 hover:-translate-y-1 hover:border-black/40 hover:bg-white hover:shadow-xl focus:outline-none focus-visible:-translate-y-1 focus-visible:border-black focus-visible:ring-2 focus-visible:ring-black/20 sm:p-5"
					>
						<div class="flex items-start gap-4">
							<h3 class="font-semibold text-black">UFC Fight Predictor</h3>
						</div>
						<p class="text-black/70 mt-3"> ETL pipeline to process UFC data and probabilistic ML model using Random Forest and XGBoost to predict UFC fights</p>
						<ul class="mt-5 grid grid-cols-1 gap-x-8 gap-y-3 sm:grid-cols-2">
							<li class="flex items-center gap-2 text-black/80">
								<span class="w-1.5 h-1.5 bg-pink-400 rounded-full"></span>
								Python
							</li>
							<li class="flex items-center gap-2 text-black/80">
								<span class="w-1.5 h-1.5 bg-pink-400 rounded-full"></span>
								Scikit-learn
							</li>
							<li class="flex items-center gap-2 text-black/80">
								<span class="w-1.5 h-1.5 bg-pink-400 rounded-full"></span>
								Scrapy
							</li>
							<li class="flex items-center gap-2 text-black/80">
								<span class="w-1.5 h-1.5 bg-pink-400 rounded-full"></span>
								Postgresql
							</li>
						</ul>
					</a>

					<div class="rounded-xl border border-black/15 bg-white/80 p-4 sm:p-5">
						<div class="flex justify-between items-start gap-4">
							<h3 class="font-semibold text-black">Daily Wins</h3>
						</div>
						<p class="text-black/70 mt-3"> iOS mobile app to track daily habits and gamify productivity </p>
						<ul class="mt-5 grid grid-cols-1 gap-x-8 gap-y-3 sm:grid-cols-2">
							<li class="flex items-center gap-2 text-black/80">
								<span class="w-1.5 h-1.5 bg-pink-400 rounded-full"></span>
								Swift
							</li>
							<li class="flex items-center gap-2 text-black/80">
								<span class="w-1.5 h-1.5 bg-pink-400 rounded-full"></span>
								Firebase
							</li>
						</ul>
					</div>
				</div>
			</div>
		</div>
		<slot />
		<style>
			body {
				font-family: "Roboto Mono", monospace;
				font-optical-sizing: auto;
				font-weight: 350;
				font-style: normal;
			}
		</style>
		<script>
				import Typed from 'typed.js';

				var typed = new Typed('#typed', {
					stringsElement: '#typed-strings',
					typeSpeed: 80,
					loop: true,
					showCursor: true
				});
		</script>
	</body>
</html>
